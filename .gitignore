# ═══════════════════════════════════════════════════
# RajAI .gitignore
# ═══════════════════════════════════════════════════

# ─── Node ───
node_modules/
dist/
dist-ssr/
*.local
.vite/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# ─── Python ───
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
venv/
env/
ENV/
.venv/
pip-log.txt
pip-delete-this-directory.txt
.pytest_cache/
.mypy_cache/
.ruff_cache/

# ─── RajAI Specific ───
# User-uploaded PDFs
backend/uploads/
# Vector database
backend/chroma_db/
# SQLite chat history
backend/rajai.db
backend/*.db
backend/*.sqlite3

# ─── Env & Secrets ───
.env
.env.local
.env.*.local
*.key
*.pem

# ─── IDE ───
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store

# ─── Logs ───
*.log
logs/

# ─── OS ───
Thumbs.db
Desktop.ini
$RECYCLE.BIN/